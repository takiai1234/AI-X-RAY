# Backend cho AI Agent Demo, thứ tự ưu tiên:
# 1) 9router (OpenAI-compatible, ví dụ http://127.0.0.1:20128/v1)
LLM_BASE_URL=
LLM_MODEL=cc/claude-sonnet-5
LLM_API_KEY=
# 2) Claude API chính thức (dùng khi không có LLM_BASE_URL)
ANTHROPIC_API_KEY=
# 3) Không có gì → output mẫu cá nhân hóa (phễu vẫn chạy đủ)

# Webhook CRM: mỗi lead submit sẽ POST JSON (hồ sơ + AI Score + lead score + behavior) về URL này.
# Ví dụ: webhook n8n / Lark / Google Sheets.
CRM_WEBHOOK_URL=

# Webhook tracking (tùy chọn): nhận toàn bộ event phễu (Phụ lục C).
TRACK_WEBHOOK_URL=

# Mật khẩu trang quản trị /admin (bắt buộc để dùng admin).
ADMIN_PASSWORD=
